{
  "name": "@followup/design-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Core UI primitives aligned to Tecma design tokens.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src/index.ts src/components/Button.tsx src/components/Input.tsx src/components/PasswordInput.tsx src/components/CheckboxWithLabel.tsx src/components/LogoTecma.tsx src/utils/joinClasses.ts --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo 'no tests for design-ui' && exit 0",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@followup/design-icons": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  }
}
