{
  "name": "@followup/design-themes",
  "version": "0.1.0",
  "private": true,
  "description": "Theme layers built on top of Followup design tokens.",
  "type": "module",
  "sideEffects": [
    "./css/auth-theme.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth.css": "./css/auth-theme.css"
  },
  "files": [
    "dist",
    "css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo 'no tests for design-themes' && exit 0",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@followup/design-tokens": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
