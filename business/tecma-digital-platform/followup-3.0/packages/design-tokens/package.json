{
  "name": "@followup/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens (TypeScript + CSS variables + fonts) for the Followup design system.",
  "type": "module",
  "sideEffects": [
    "./css/tokens.css",
    "./css/fonts.css",
    "./css/auth-primitives.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./css/tokens.css",
    "./fonts.css": "./css/fonts.css",
    "./tokens.css": "./css/tokens.css",
    "./auth-primitives.css": "./css/auth-primitives.css"
  },
  "files": [
    "dist",
    "css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo 'no tests for design-tokens' && exit 0",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
