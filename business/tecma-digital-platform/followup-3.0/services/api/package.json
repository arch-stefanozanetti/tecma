{
  "name": "@followup/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint src tests --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage --passWithNoTests",
    "test:hardening": "vitest run --coverage --passWithNoTests",
    "test:integration": "vitest run --coverage",
    "openapi:generate": "OPENAPI_GENERATE=1 tsx src/docs/generateOpenApi.ts",
    "migrate:tz-users": "node ./scripts/migrate-tz-users.mjs",
    "migrate:tz-collections": "node ./scripts/migrate-tz-collections.mjs",
    "sync:tecma-admin-role": "node ./scripts/sync-tecma-admin-system-role.mjs"
  },
  "dependencies": {
    "@fastify/aws-lambda": "^6.4.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.1",
    "@followup/db": "workspace:*",
    "@followup/logger": "workspace:*",
    "@followup/shared-config": "workspace:*",
    "@followup/shared-rbac": "workspace:*",
    "@followup/shared-types": "workspace:*",
    "@sentry/node": "^8.45.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "jose": "^5.9.6",
    "mongodb": "^6.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "yaml": "^2.6.1"
  }
}
