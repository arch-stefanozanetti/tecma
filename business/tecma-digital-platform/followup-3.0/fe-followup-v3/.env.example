VITE_BUSINESSPLATFORM_LOGIN=https://businessplatform-biz-tecma-dev1.tecmasolutions.com/login

# Dev-1 multi-canale (stesso dominio, path prefix). In CI: `VITE_BASE_PATH=/app/main/ pnpm build`.
# In locale lasciare vuoto (default `/`).
# VITE_BASE_PATH=

# Tendina build (legge channels.json in public o alla root deploy). Solo ambienti dev-1.
# VITE_SHOW_DEV_CHANNEL_PICKER=true
# Opzionale: URL manifest (default /channels.json)
# VITE_CHANNELS_MANIFEST_URL=/channels.json

# Keycloak come IdP (OIDC + PKCE). Se valorizzati, il pulsante SSO usa Keycloak invece della BusinessPlatform.
# Il backend deve avere SSO_JWKS_URI = https://<keycloak>/realms/<realm>/protocol/openid-connect/certs
# e opzionalmente SSO_JWT_ISSUER / SSO_JWT_AUDIENCE allineati al client Keycloak.
# In Keycloak: client pubblico, Standard flow ON, Direct access grants OFF consigliato; Valid Redirect URIs:
#   http://localhost:5177/login/keycloak-callback  (e l’URL di produzione del FE con lo stesso path)
# VITE_KEYCLOAK_URL=https://auth.example.com
# VITE_KEYCLOAK_REALM=myrealm
# VITE_KEYCLOAK_CLIENT_ID=followup-spa
# Opzionale: VITE_KEYCLOAK_SCOPE=openid email profile
# Opzionale: VITE_KEYCLOAK_REDIRECT_PATH=/login/keycloak-callback

# Base URL delle API. In locale NON impostare: il proxy Vite inoltra /v1 a http://localhost:8080.
# Render (FE statico + BE separato): includere sempre /v1 finale:
#   VITE_API_BASE_URL=https://followup-3-be.onrender.com/v1
# Sul servizio BE Render: APP_PUBLIC_URL=https://followup-3-fe.onrender.com (altrimenti CORS → "Failed to fetch").
# Gateway Tecma:
#   dev-1:  https://api.tecmasolutions.com/biz-tecma-dev1/v1
# VITE_API_BASE_URL=

# Auth tramite gateway BSS (single sign-on piattaforma). Opzionale, default false.
# Se true: il FE usa POST /login (BSS) e POST /v1/users/getUserByJWT come "me", refresh con /v1/auth/refresh-token.
# Richiede VITE_API_BASE_URL verso api.tecmasolutions.com. Vedi docs/BSS_INTEGRATION.md.
# VITE_USE_BSS_AUTH=false
