{
  "name": "followup-3.0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Followup 3.0 — Production-ready CRM monorepo (apps + services + packages)",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:web+api": "turbo run dev --filter=@followup/web --filter=@followup/api",
    "lint": "turbo run lint",
    "lint:openapi": "spectral lint services/api/openapi/openapi.v1.yaml --ruleset .spectral.yaml",
    "lint:openapi:domains": "spectral lint architecture/aws-api-gateway/domains/auth/v1/openapi.yaml architecture/aws-api-gateway/domains/platform/v1/openapi.yaml --ruleset architecture/aws-api-gateway/.spectral.yaml",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:security": "vitest run --config tests/security/vitest.config.ts",
    "test:hardening": "pnpm -C services/api run test:hardening && pnpm -C apps/web run test:hardening",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:semgrep": "semgrep --config=.semgrep.yml .",
    "security:osv": "osv-scanner --recursive .",
    "security:trivy": "trivy fs --scanners vuln,secret,misconfig .",
    "security:all": "pnpm security:semgrep && pnpm security:osv && pnpm security:trivy",
    "security:hardening": "bash scripts/security/run-scans.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@stoplight/spectral-cli": "^6.14.2",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
