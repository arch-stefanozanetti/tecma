# Rotazione secret e variabili sensibili: vedi docs/RUNBOOK_DEPLOY.md (sezione "Rotazione secret").
# Stack locale consigliato: dalla root del monorepo `pnpm dev` (avvia in parallelo tutti i `dev`, inclusi API + web)
# oppure solo API + web: `pnpm dev:web+api`.
# Deve risolvere a .../v1/auth/login (backend greenfield services/api).
# Esempi validi: /v1 (consigliato: proxy Vite → VITE_PROXY_TARGET, default http://localhost:8080; stessa origine, niente CORS).
# In alternativa URL diretto: http://localhost:8080/v1 (o host senza path → si aggiunge /v1): l’API deve consentire CORS con header x-api-key.
VITE_API_BASE_URL=/v1
# Obbligatoria: l’API greenfield richiede header x-api-key (il POC `fe-followup-v3` no). Deve coincidere con INTERNAL_API_KEY in services/api/.env (≥16 caratteri).
# Se la lasci vuota, `pnpm dev` in apps/web prova a copiarla da ../../services/api/.env — se non trova il file, avrai HTTP 401 dopo il login.
# Esempio (allinea al tuo backend): VITE_API_KEY=change-this-api-key-123456
VITE_API_KEY=
VITE_APP_ENV=dev-1
VITE_USE_SSO=true
