# Rotazione secret e variabili sensibili: vedi docs/RUNBOOK_DEPLOY.md (sezione "Rotazione secret").
# Deve risolvere a .../v1/auth/login (backend greenfield services/api).
# Esempi validi: /v1 (con proxy Vite), http://localhost:8080/v1
# oppure http://localhost:8080 (senza path): viene aggiunto automaticamente /v1.
VITE_API_BASE_URL=/v1
# In locale, se lasci vuoto, Vite legge INTERNAL_API_KEY da services/api/.env o .env.local (vedi vite.config.ts).
VITE_API_KEY=
VITE_APP_ENV=dev-1
VITE_USE_SSO=true
