# Esempio locale: usare secret gestiti dalla piattaforma negli ambienti remoti.
NODE_ENV=development
APP_ENV=dev-1
PORT=8080
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=test-zanetti
# Connessione opzionale dedicata all'audit sullo stesso ambiente greenfield.
# AUDIT_MONGO_URI=mongodb://followup_audit_writer:replace-me@localhost:27017/test-zanetti
# AUDIT_MONGO_DB_NAME=test-zanetti
# Deve coincidere con MONGO_DB_NAME (gate scritture su DB sbagliato)
ALLOWED_WRITE_DB=test-zanetti
# Necessario per bootstrap indici e script operativi sugli ambienti greenfield approvati.
# ENABLE_POC_TZ_WRITES=1
AUTH_JWT_SECRET=change-this-secret-with-min-32-characters
# Optional JWT key id (kid) for key rotation metadata.
# AUTH_JWT_KID=jwt-key-2026-05
AUTH_JWT_EXPIRES_IN=15m
AUTH_REFRESH_EXPIRES_DAYS=7
INTERNAL_API_KEY=change-this-api-key-123456
CORS_ORIGINS=http://localhost:5177
# Rate limit globale: DISABILITATO automaticamente se NODE_ENV=development o test.
# Se in locale vedi ancora 429, il tuo .env ha probabilmente NODE_ENV=production →
# metti NODE_ENV=development, oppure forza: API_DISABLE_RATE_LIMIT=1
# Opzionale (solo staging/prod con rate limit attivo): max richieste/min per IP (default 100).
# POST /v1/auth/login e /v1/auth/refresh non contano nel bucket.
# API_RATE_LIMIT_MAX=500
# Optional — obbligatorio in produzione per /v1/auth/sso-exchange (senza JWKS valido → 503)
# SSO_JWKS_URI=https://keycloak.example.com/realms/tecma/protocol/openid-connect/certs
# REDIS_URL=redis://localhost:6379
# SENTRY_DSN=
# DATADOG_API_KEY=
# Datadog runtime tags (nessun secret deve essere salvato nel repository).
# DD_ENV=dev1
# DD_SERVICE=followup-api
# DD_VERSION=local
# DD_LOGS_INJECTION=true
# DD_TRACE_ENABLED=false

# SMTP inviti/password reset (AWS SES SMTP o altro provider SMTP).
# In locale, se SMTP_HOST/SMTP_URL è configurato, le mail partono davvero.
# Usa SMTP_DELIVERY_MODE=mock per forzare il mock/log locale.
# SMTP_DELIVERY_MODE=auto
# SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=replace-with-smtp-user
# SMTP_PASS=replace-with-smtp-password
# SMTP_FROM=Followup <noreply@example.com>
# SMTP_URL=smtp://user:pass@email-smtp.eu-west-1.amazonaws.com:587
